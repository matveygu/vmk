# Local Python/runserver only. Docker uses .env.docker instead.
# Create with: python docker/init_env.py --local
# Do not run this SQLite profile as a second live database after migrating.

# Application / security
DJANGO_SECRET_KEY=GENERATE_ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_CLIENT_IP=False
PORTAL_PUBLIC_URL=http://127.0.0.1:8000

# Local database. Docker explicitly overrides this with PostgreSQL.
DATABASE_ENGINE=sqlite
DATABASE_TIMEOUT=20
# SQLITE_PATH defaults to data/db.sqlite3; PORTAL_DATA_DIR defaults to data/.

# Runtime
LOG_LEVEL=INFO
SEMESTER_START_DATE=2026-01-15

# Local emails are printed to the terminal, NOT sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Учебный портал ВМК МГУ <noreply@localhost>
