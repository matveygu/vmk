# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Render/Production Deployment
RENDER_EXTERNAL_HOSTNAME=

# Without these options, local runserver continues using SQLite.
# Docker has a separate configuration: .env.docker.example -> .env.docker.
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=msu_portal
# POSTGRES_USER=msu_portal
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Logging
LOG_LEVEL=INFO

# Local testing: emails (codes and reset links) are printed in the server terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PORTAL_PUBLIC_URL=http://127.0.0.1:8000

# On Yandex Cloud, set these variables to your email provider's values:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-smtp-login
# EMAIL_HOST_PASSWORD=your-app-password-or-smtp-secret
# DEFAULT_FROM_EMAIL=Учебный портал ВМК МГУ <noreply@your-domain.ru>
# PORTAL_PUBLIC_URL=https://your-domain.ru
