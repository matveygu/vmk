**/.env
**/.env.*
**/service-account.json
**/service_account.json
**/teachers*.json
**/*.pem
**/*.key
data
backups
staticfiles
**/*.sqlite3*
**/*.dump
**/*.sql.gz
**/*.log
**/*.log.*
schedule/schedule_sources

# Host environments and build/test caches.
**/.venv*
**/venv
**/env
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox
**/.coverage*
htmlcov
coverage.xml
