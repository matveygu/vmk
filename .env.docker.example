# Docker + PostgreSQL. Create with: python docker/init_env.py
# Defaults are for LOCAL testing. Production checklist: docs/environment.md.

# Database: NEVER change the password here alone after volume initialization.
POSTGRES_DB=msu_portal
POSTGRES_USER=msu_portal
POSTGRES_PASSWORD=GENERATE_ME
# Compose sets DATABASE_ENGINE=postgresql and POSTGRES_HOST=db itself.

# Application / security
DJANGO_SECRET_KEY=GENERATE_ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_CLIENT_IP=False
PORTAL_PUBLIC_URL=http://127.0.0.1:8000

# Runtime: logs go to Docker (rotation is configured in compose.yaml).
LOG_LEVEL=INFO
SEMESTER_START_DATE=2026-01-15

# Local emails are printed to logs, NOT sent. For production use SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Учебный портал ВМК МГУ <noreply@localhost>
