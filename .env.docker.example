# Copy with: python docker/init_env.py
# Local defaults. For Yandex Cloud, apply the production settings in the guide.
POSTGRES_DB=msu_portal
POSTGRES_USER=msu_portal
POSTGRES_PASSWORD=GENERATE_ME
DJANGO_SECRET_KEY=GENERATE_ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_CLIENT_IP=False
PORTAL_PUBLIC_URL=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Учебный портал ВМК МГУ <noreply@localhost>
